       fhir:id [ fhir:v "ClinicalDocument.effectiveTime" ] ;
       fhir:path [ fhir:v "ClinicalDocument.effectiveTime" ] ;
       fhir:short [ fhir:v "Date de création du document Synthèse Médicale." ] ;
       fhir:definition [ fhir:v "Signifies the document creation time, when the document first came into being." ] ;
       fhir:comment [ fhir:v "Where the CDA document is a transform from an original document in some other format, the ClinicalDocument.effectiveTime is the time the original document is created. The time when the transform occurred is not currently represented in CDA." ] ;
