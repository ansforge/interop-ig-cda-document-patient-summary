       fhir:path [ fhir:v "ClinicalDocument.recordTarget" ] ;
       fhir:short [ fhir:v "Patient/Usager concerné par le document." ] ;
       fhir:comment [ fhir:v "A clinical document typically has exactly one recordTarget participant. In the uncommon case where a clinical document (such as a group encounter note) is placed into more than one patient chart, more than one recordTarget participants can be stated." ] ;
       fhir:requirements [ fhir:v "The recordTarget(s) of a document are stated in the header and propagate to nested content, where they cannot be overridden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "ClinicalDocument.recordTarget" ] ;
         fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "*" ]
       ] ;
       fhir:type ( [
         fhir:code [ fhir:v "http://hl7.org/cda/stds/core/StructureDefinition/RecordTarget"^^xsd:anyURI ] ;
         fhir:profile ( [
           fhir:v "https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-record-target|0.1.0"^^xsd:anyURI ;
           fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-record-target|0.1.0>
         ] )
       ] )
     ] [
       fhir:id [ fhir:v "ClinicalDocument.author" ] ;
       fhir:path [ fhir:v "ClinicalDocument.author" ] ;
       fhir:short [ fhir:v "Professionnel ou patient/usager ou système, auteur du document incluant la structure de rattachement de l'auteur." ] ;
       fhir:comment [ fhir:v "In some cases, the role or function of the author is inherent in the ClinicalDocument.code, such as where ClinicalDocument.code is 'Medical Student Progress Note'. The role of the author can also be recorded in the Author.functionCode or AssignedAuthor.code attribute. If either of these attributes is included, they should be equivalent to or further specialize the role inherent in the ClinicalDocument.code (such as where the ClinicalDocument.code is simply 'Physician Progress Note' and the value of Author.functionCode is 'rounding physician'), and shall not conflict with the role inherent in the ClinicalDocument.code, as such a conflict would constitute an ambiguous situation." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
