       fhir:path [ fhir:v "ClinicalDocument.title" ] ;
       fhir:short [ fhir:v "Titre du document : SYNTHESE MEDICALE." ] ;
       fhir:comment [ fhir:v "It's commonly the case that clinical documents do not have a title, and are collectively referred to by the display name of ClinicalDocument.code (e.g. a 'consultation' or 'progress note'). Where these display names are rendered to the clinician, or where the document has a unique title, the ClinicalDocument.title component should be used." ] ;
