       fhir:path [ fhir:v "ClinicalDocument.participant.time.width" ] ;
       fhir:label [ fhir:v "Width" ] ;
       fhir:definition [ fhir:v "The difference between high and low boundary. The purpose of distinguishing a width property is to handle all cases of incomplete information symmetrically. In any interval representation only two of the three properties high, low, and width need to be stated and the third can be derived." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "0" ] ;
